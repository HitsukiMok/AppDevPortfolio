    </div>

    <div class="project-container">

        <!-- PROJECT 1 -->
        <div class="project-card">

            <h3>FORGET-ME-NOT</h3>

            <p class="project-category">STUDENT LEARNING APPLICATION</p>

            <p class="project-description">
                A learning and reviewing web application designed
                for students to track their learning progress.
                Users can rate lessons based on whether they forgot,
                are familiar with, or remember the material.
            </p>

        </div>


        <!-- PROJECT 2 -->
        <div class="project-card">

            <h3>NTORE</h3>

            <p class="project-category">IMAGE STORAGE APPLICATION</p>

            <p class="project-description">
                An image storage and compression application that
                allows users to store and back up their photos online
                and offline. It helps users free up gallery space
                while keeping their images secure.
            </p>

        </div>


        <!-- PROJECT 3 -->
        <div class="project-card">

            <h3>REALCORNERS</h3>

            <p class="project-category">AI DETECTION WEB EXTENSION</p>

            <p class="project-description">
                An AI detection browser extension for Facebook
                that identifies AI-generated posts and content.
                Detected AI content receives a yellow border,
                while non-AI content receives a green border.
            </p>

        </div>


        </div>

    </div>

</section>


