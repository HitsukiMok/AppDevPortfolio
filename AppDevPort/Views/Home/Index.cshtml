    <script>
            // Certificate viewer
            const viewer = document.getElementById("cert-viewer");
            const viewerImg = document.getElementById("cert-viewer-img");
            document.querySelectorAll(".cert").forEach(card => {
                card.addEventListener("click", () => {
                    const img = card.querySelector("img");
                    viewerImg.src = img.src;
                    viewerImg.alt = img.alt;
                    viewer.showModal();
                });
            });
            viewer.querySelector(".cert-close").addEventListener("click", () => viewer.close());
            viewer.addEventListener("click", e => { if (e.target === viewer) viewer.close(); });
    </script>
